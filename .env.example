# ==========================================
# DEAN'S EMAIL DIGEST CONFIGURATION
# ==========================================

# --- 1. EMAIL CONFIGURATION (IMAP / GMAIL) ---
# For Gmail: Use an App Password (not your normal password).
# Steps: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=dean.office@college.edu
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_LOOKBACK_HOURS=24

# --- 2. AI CONFIGURATION (GOOGLE GEMINI) ---
# Get free API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- 3. WHATSAPP CONFIGURATION (TWILIO) ---
# Get free trial from: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEAN_WHATSAPP_TO=whatsapp:+919876543210

# --- 4. DIGEST SETTINGS ---
# Set timezone for email timestamps (e.g., Asia/Kolkata, America/New_York)
TIMEZONE=Asia/Kolkata
